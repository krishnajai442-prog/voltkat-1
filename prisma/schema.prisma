generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ─────────────────────────── Enums ───────────────────────────
 */

enum SpecKind {
  SPEC
  WARRANTY
  MFG
}

enum ImageKind {
  GALLERY
  SHOWCASE
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REPLACED
  REFUNDED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  WRONG_PRODUCT
  NOT_WORKING
  MISSING_ACCESSORY
  OTHER
}

enum TicketStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum FeatureSection {
  NEW_ARRIVALS
  HOT_DEALS
  TRENDING
  BEST_SELLERS
  WISHLIST
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  BRAND
}

enum GradientTheme {
  MIDNIGHT
  VIOLET_STORM
  ELECTRIC_AZURE
  EMERALD_TECH
  SUNSET_DEAL
  STEEL_GRAPHITE
}

/**
 * ─────────────────────────── Identity ────────────────────────
 */

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             Role      @default(CUSTOMER)
  whatsappOptIn    Boolean   @default(false)
  marketingOptIn   Boolean   @default(true)
  active           Boolean   @default(true)
  avatarUrl        String?
  resetTokenHash   String?
  resetTokenExp    DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  questions       Question[]
  answers         Answer[]
  cart            Cart?
  wishlist        Wishlist?
  compareItems    CompareItem[]
  recentlyViewed  RecentlyViewed[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
  returnRequests  ReturnRequest[]
  auditLogs       AuditLog[]
  feedback        Feedback[]

  @@index([role])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  fullName  String
  phone     String
  altPhone  String?
  pincode   String
  line1     String
  line2     String?
  city      String
  state     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([pincode])
}

/**
 * ─────────────────────────── Catalog ─────────────────────────
 */

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
  offers   Offer[]   @relation("CategoryOffer")
  coupons  Coupon[]  @relation("CouponCategory")
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  categories  String[] @default([])
  name        String
  logoUrl     String?
  countryCode String?
  active      Boolean  @default(true)

  products Product[]
  offers   Offer[]   @relation("BrandOffer")
  coupons  Coupon[]  @relation("CouponBrand")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  groupId          String?
  name             String
  shortDescription String?
  categoryId       String
  brandId          String
  mrp              Int
  salePrice        Int
  showcaseImages   String[] @default([])
  discountPercent  Int      @default(0)
  stock            Int      @default(0)
  lowStockAt       Int      @default(5)
  ratingAvg        Float    @default(0)
  ratingCount      Int      @default(0)
  sold             Int      @default(0)
  views            Int      @default(0)
  featured         Boolean  @default(false)
  active           Boolean  @default(true)
  subtype          String?
  ram              String?
  storage          String?
  screenSize       String?
  processor        String?
  color            String?
  warrantyMonths   Int      @default(12)
  returnableDays   Int      @default(7)
  codEligible      Boolean  @default(true)
  emiEligible      Boolean  @default(true)
  exchangeEligible Boolean  @default(true)
  hsnCode          String?
  tags             String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  colors           String[] //@default([])
  variants         Json? // [{ "label": string, "add": number }] — price delta over base
  optionGroups     Json?
  colorOptions     Json?

  category       Category               @relation(fields: [categoryId], references: [id])
  brand          Brand                  @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  specifications ProductSpecification[]
  offers         Offer[]
  reviews        Review[]
  questions      Question[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  compareItems   CompareItem[]
  recentlyViewed RecentlyViewed[]
  features       ProductFeature[]
  slideLinks     HeroSlideProduct[]
  freqBoughtWith FrequentlyBoughtPair[] @relation("FbpPrimary")
  freqBoughtIn   FrequentlyBoughtPair[] @relation("FbpAddOn")

  @@index([groupId])
  @@index([slug])
  @@index([categoryId, active])
  @@index([brandId])
  @@index([salePrice])
  @@index([ratingAvg])
  @@index([featured, active])
  @@index([discountPercent])
  @@index([stock])
  @@index([createdAt])
  @@index([subtype])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int       @default(0)
  isPrimary Boolean   @default(false)
  kind      ImageKind @default(GALLERY)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  group     String   @default("General")
  label     String
  value     String
  kind      SpecKind @default(SPEC)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, group])
}

model Offer {
  id          String    @id @default(cuid())
  type        String // BANK | EXCHANGE | EMI | COMBO | FESTIVAL | DEAL
  title       String
  description String
  code        String?   @unique
  bankName    String?
  productId   String?
  categoryId  String?
  brandId     String?
  active      Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation("CategoryOffer", fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation("BrandOffer", fields: [brandId], references: [id], onDelete: SetNull)

  @@index([active, startsAt])
  @@index([productId])
}

model SpecTemplate {
  id           String   @id @default(cuid())
  name         String
  categorySlug String
  specs        Json // [{group,label,value}] with {placeholders}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Pincode {
  pin   String  @id // 6-digit, e.g. "852131"
  city  String // taluk / town-level, e.g. "Kahalgoon"
  state String? // optional; map fills it when absent

  @@index([city])
}

model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  description   String?
  type          CouponType  @default(PERCENT)
  value         Int
  scope         CouponScope @default(ALL)
  categoryId    String?
  brandId       String?
  minOrderValue Int         @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int         @default(0)
  perUserLimit  Int         @default(1)
  active        Boolean     @default(true)
  startsAt      DateTime    @default(now())
  endsAt        DateTime?
  broadcast     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category    Category?          @relation("CouponCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?             @relation("CouponBrand", fields: [brandId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]
  orderLinks  OrderCoupon[]

  @@index([code, active])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String?
  discount  Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model OrderCoupon {
  orderId  String
  couponId String
  discount Int

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@id([orderId, couponId])
}

model Banner {
  id        String   @id @default(cuid())
  slot      String // HERO_TEXT | PROMO_STRIP | CATEGORY | SALE | FOOTER
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([slot, active])
}

model HeroSlide {
  id             String        @id @default(cuid())
  kind           String        @default("CUSTOM") // AUTO | CUSTOM
  badge          String
  headline       String
  highlight      String? // last two words rendered in gradient
  description    String?
  ctaLabel       String        @default("Shop Now")
  ctaHref        String?
  secondaryLabel String?
  secondaryHref  String?
  image          String?
  gradient       GradientTheme @default(MIDNIGHT)
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdBy      String?
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  products HeroSlideProduct[]

  @@index([active, sortOrder])
}

model HeroSlideProduct {
  slideId   String
  productId String
  position  Int     @default(0)
  image     String?

  slide   HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([slideId, productId])
  @@index([productId])
}

model ProductFeature {
  id        String         @id @default(cuid())
  section   FeatureSection
  productId String
  position  Int            @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([section, productId])
  @@index([section, position])
}

model FrequentlyBoughtPair {
  id        String @id @default(cuid())
  primaryId String
  addOnId   String

  primary Product @relation("FbpPrimary", fields: [primaryId], references: [id], onDelete: Cascade)
  addOn   Product @relation("FbpAddOn", fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([primaryId, addOnId])
}

/**
 * ─────────────────────────── Cart & Lists ────────────────────
 */

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

/**
 * ─────────────────────────── Orders ──────────────────────────
 */

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  guestEmail        String?
  guestPhone        String?
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  subtotalMrp       Int
  subtotal          Int
  itemDiscount      Int
  couponDiscount    Int           @default(0)
  couponCode        String?
  deliveryFee       Int           @default(0)
  codFee            Int           @default(0)
  total             Int
  gstRate           Int           @default(18)
  gstComponent      Int           @default(0)
  deliveryMode      String        @default("STANDARD") // STANDARD | EXPRESS
  etaFrom           DateTime?
  etaTo             DateTime?
  carrier           String?
  trackingNumber    String?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  confirmedAt       DateTime?
  shippedAt         DateTime?
  processedAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveryOtp       String? // 6-digit code, set when SHIPPED/OUT_FOR_DELIVERY
  deliveryOtpSentAt DateTime? // when it was generated/sent (for "resend" cooldown)
  deliveredByOtp    Boolean       @default(false) // true once OTP matched at delivery
  updatedByUserId   String?
  invoiceUrl        String?
  note              String?
  ip                String?
  addressSnapshot   Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  addressId      String?
  address        Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  trackingEvents TrackingEvent[]
  returnRequests ReturnRequest[]
  couponLinks    OrderCoupon[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  name           String
  slug           String
  brand          String
  image          String?
  unitMrp        Int
  unitPrice      Int
  quantity       Int
  lineTotal      Int
  warrantyMonths Int     @default(12)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnRequest ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  amountPaise         Int
  currency            String        @default("INR")
  gateway             String        @default("RAZORPAY")
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  refundId            String?
  refundedAmountPaise Int           @default(0)
  failureReason       String?
  rawJson             Json?
  capturedAt          DateTime?
  createdAt           DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model TrackingEvent {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  title       String
  description String?
  location    String?
  actorId     String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderItemId String
  orderId     String
  userId      String?
  reason      ReturnReason
  details     String?
  status      ReturnStatus @default(REQUESTED)
  resolution  String? // REFUND | REPLACEMENT
  adminNote   String?
  pickupEta   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderItemId])
  @@index([orderId])
  @@index([status])
}

/**
 * ─────────────────────────── Community ───────────────────────
 */

model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String
  orderId      String?
  rating       Int
  title        String?
  body         String
  images       String[] @default([])
  verified     Boolean  @default(false)
  helpfulCount Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model Question {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  body      String
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers Answer[]

  @@index([productId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  body       String
  isOfficial Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Feedback {
  id              String   @id @default(cuid())
  userId          String?
  name            String?
  email           String?
  productQuality  Int?
  delivery        Int?
  customerService Int?
  packaging       Int?
  website         Int?
  overall         Int?
  comment         String
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model SupportTicket {
  id        String           @id @default(cuid())
  reference String           @unique
  userId    String?
  orderId   String?
  email     String
  phone     String?
  subject   String
  category  String           @default("GENERAL")
  status    TicketStatus     @default(OPEN)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  staffId   String?
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/**
 * ─────────────────────────── Ops ─────────────────────────────
 */

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  audience  String   @default("USER") // USER | STAFF
  title     String
  body      String
  href      String?
  channel   String   @default("IN_APP")
  template  String?
  read      Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([audience, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

model Subscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  whatsappOptIn Boolean  @default(false)
  source        String   @default("NEWSLETTER")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([active])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}
